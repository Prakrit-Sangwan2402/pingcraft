# PingCraft Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local mongod)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pingcraft?retryWrites=true&w=majority

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_pingcraft_dev_replace_in_production
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Background Worker Settings
RUN_WORKER=true
