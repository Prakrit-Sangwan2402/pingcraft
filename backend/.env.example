# PingCraft Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g., MongoDB Atlas URI or local mongod)
# If left empty in development/test, an in-memory database will be used automatically.
MONGODB_URI=mongodb://localhost:27017/pingcraft

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_pingcraft_dev_replace_in_production
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Background Worker Settings
RUN_WORKER=true
